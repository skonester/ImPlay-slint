import { Ic } from "icons.slint";
import { MenuItem, MenuSep, SidePanel, Stepper, VScroll } from "widgets.slint";
import { PlayerState } from "state.slint";

export component SubtitlePanel inherits SidePanel {
    heading: "Subtitles";
    panel-width: 300px;
    callback select-sub(int);
    callback load-external-sub();
    callback command(string);
    callback set-sub-delay(float);

    VScroll {
        min-height: 40px;
        max-height: 240px;
        VerticalLayout {
            MenuItem {
                show-check: true;
                checked: !PlayerState.sub-active;
                label: "Disabled";
                clicked => { root.select-sub(-1); }
            }
            for t in PlayerState.panel-sub-tracks: MenuItem {
                show-check: true;
                checked: t.selected;
                active: t.selected;
                label: t.label;
                clicked => { root.select-sub(t.id); }
            }
            if PlayerState.panel-sub-tracks.length == 0: MenuItem { label: "No subtitle tracks"; }
        }
    }
    MenuSep {}
    MenuItem { icon: Ic.folder-open; label: "Load external subtitle..."; clicked => { root.load-external-sub(); } }
    MenuItem {
        icon: Ic.subtitles;
        label: "Visible";
        show-check: true;
        checked: PlayerState.sub-visible;
        active: PlayerState.sub-visible;
        clicked => { root.command("cycle sub-visibility"); }
    }
    MenuSep {}
    Stepper {
        label: "Position";
        value: "\{PlayerState.sub-position}%";
        active: PlayerState.sub-position != 100;
        dec => { root.command("add sub-pos -1"); }
        inc => { root.command("add sub-pos 1"); }
        reset => { root.command("set sub-pos 100"); }
    }
    Stepper {
        label: "Delay";
        value: "\{round(PlayerState.sub-delay * 10) / 10}s";
        active: PlayerState.sub-delay != 0;
        dec => {
            PlayerState.sub-delay = round((PlayerState.sub-delay - 0.1) * 10) / 10;
            root.set-sub-delay(PlayerState.sub-delay);
        }
        inc => {
            PlayerState.sub-delay = round((PlayerState.sub-delay + 0.1) * 10) / 10;
            root.set-sub-delay(PlayerState.sub-delay);
        }
        reset => { PlayerState.sub-delay = 0; root.set-sub-delay(0); }
    }
    Stepper {
        label: "Scale";
        value: "\{round(PlayerState.sub-scale * 10) / 10}x";
        active: PlayerState.sub-scale != 1;
        dec => { root.command("add sub-scale -0.1"); }
        inc => { root.command("add sub-scale 0.1"); }
        reset => { root.command("set sub-scale 1"); }
    }
}
