import { Theme } from "theme.slint";
import { Ic, AppIcon } from "icons.slint";
import { CtrlButton, MenuItem, MenuSep, MenuSurface, SidePanel, Stepper, VolumeControl, RowHover, VScroll } from "widgets.slint";
import { ChapterRow, TrackRow, ChoiceRow, PlaylistRow, InfoRow, PlayerState, Catalog } from "state.slint";
import { ContextMenu } from "context-menu.slint";
import { SubtitlePanel } from "subtitle-panel.slint";
import { SettingsPanel } from "settings-panel.slint";

// Re-export the data structs built by the native C++ bridge.
export { ChapterRow, TrackRow, ChoiceRow, PlaylistRow, InfoRow }

export component AppWindow inherits Window {
    title: "ImPlay";
    no-frame: true;
    background: transparent;
    default-font-family: Theme.font;
    preferred-width: 896px;
    preferred-height: 504px;
    min-width: 640px;
    min-height: 360px;

    // ImPlay supplies libmpv's OpenGL frame as a borrowed GPU texture.
    in property <image> video-frame;
    in property <int> video-width: max(1, round(root.width / 1px));
    in property <int> video-height: max(1, round(root.height / 1px));

    // Aliases keep the generated C++ API and every Slint surface on one state.
    in-out property <bool> playing <=> PlayerState.playing;
    in-out property <float> current-time <=> PlayerState.current-time;
    in-out property <float> duration <=> PlayerState.duration;
    in-out property <float> volume <=> PlayerState.volume;
    in-out property <bool> muted <=> PlayerState.muted;
    in-out property <float> speed <=> PlayerState.speed;
    in-out property <bool> fullscreen <=> PlayerState.fullscreen;
    in-out property <bool> has-file <=> PlayerState.has-file;
    in-out property <string> media-title <=> PlayerState.media-title;
    in-out property <float> max-volume <=> PlayerState.max-volume;
    in-out property <float> ab-a <=> PlayerState.ab-a;
    in-out property <float> ab-b <=> PlayerState.ab-b;
    in-out property <bool> ab-enabled <=> PlayerState.ab-enabled;
    in-out property <[ChapterRow]> chapters <=> PlayerState.chapters;

    // --- UI state ---
    in-out property <bool> controls-visible <=> PlayerState.controls-visible;
    in-out property <string> active-panel <=> PlayerState.active-panel;
    in-out property <bool> url-show <=> PlayerState.url-show;
    in-out property <string> url-text <=> PlayerState.url-text;
    in-out property <string> toast <=> PlayerState.toast;
    in-out property <string> command-text <=> PlayerState.command-text;
    property <bool> show-remaining: false;
    property <bool> cursor-hidden;
    property <int> idle-ticks;
    // True while the cursor is over a control bar. The auto-hide is driven by the
    // background video TouchArea, which never sees moves over the bars' own
    // buttons/seek/loop pills — so without this, hovering the controls would
    // still let them time out and vanish. Set from each bar's wrapping TouchArea.
    property <bool> top-hovered;
    property <bool> bottom-hovered;
    property <[string]> audio-eq-labels: ["31", "62", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"];

    // --- Context menu ---
    in-out property <bool> ctx-show <=> PlayerState.ctx-show;
    in-out property <length> ctx-x <=> PlayerState.ctx-x;
    in-out property <length> ctx-y <=> PlayerState.ctx-y;
    in-out property <string> ctx-page <=> PlayerState.ctx-page;
    in-out property <[TrackRow]> ctx-sub-tracks <=> PlayerState.ctx-sub-tracks;
    in-out property <[TrackRow]> ctx-audio-tracks <=> PlayerState.ctx-audio-tracks;
    in-out property <[TrackRow]> ctx-video-tracks <=> PlayerState.ctx-video-tracks;
    in-out property <[ChoiceRow]> recent-items <=> PlayerState.recent-items;
    in-out property <[ChoiceRow]> audio-devices <=> PlayerState.audio-devices;
    in-out property <[ChoiceRow]> profiles <=> PlayerState.profiles;
    in-out property <string> current-aspect <=> PlayerState.current-aspect;
    in-out property <bool> pinned <=> PlayerState.pinned;
    in-out property <int> sleep-min <=> PlayerState.sleep-min;
    in-out property <string> sleep-remaining <=> PlayerState.sleep-remaining;

    // --- Panels ---
    in-out property <[TrackRow]> panel-sub-tracks <=> PlayerState.panel-sub-tracks;
    in-out property <[TrackRow]> panel-audio-tracks <=> PlayerState.panel-audio-tracks;
    in-out property <bool> sub-active <=> PlayerState.sub-active;
    in-out property <float> sub-delay <=> PlayerState.sub-delay;
    in-out property <float> audio-delay <=> PlayerState.audio-delay;
    in-out property <bool> audio-eq-enabled <=> PlayerState.audio-eq-enabled;
    in-out property <[int]> audio-eq-bands <=> PlayerState.audio-eq-bands;
    in-out property <float> sub-scale <=> PlayerState.sub-scale;
    in-out property <bool> sub-visible <=> PlayerState.sub-visible;
    in-out property <[PlaylistRow]> playlist-items <=> PlayerState.playlist-items;
    in-out property <string> repeat-mode <=> PlayerState.repeat-mode;
    in-out property <bool> shuffle <=> PlayerState.shuffle;
    in-out property <[InfoRow]> info-rows <=> PlayerState.info-rows;
    in-out property <string> sub-page <=> PlayerState.sub-page;

    in-out property <int> sub-position <=> PlayerState.sub-position;

    // --- Settings ---
    in-out property <string> settings-tab <=> PlayerState.settings-tab;
    in-out property <float> def-volume <=> PlayerState.def-volume;
    in-out property <int> brightness <=> PlayerState.brightness;
    in-out property <int> contrast <=> PlayerState.contrast;
    in-out property <int> saturation <=> PlayerState.saturation;
    in-out property <float> vid-zoom <=> PlayerState.vid-zoom;
    in-out property <bool> deinterlace <=> PlayerState.deinterlace;
    in-out property <string> app-version <=> PlayerState.app-version;
    in-out property <bool> cfg-window-save <=> PlayerState.cfg-window-save;
    in-out property <bool> cfg-window-single <=> PlayerState.cfg-window-single;
    in-out property <bool> cfg-use-config <=> PlayerState.cfg-use-config;
    in-out property <bool> cfg-watch-later <=> PlayerState.cfg-watch-later;
    in-out property <bool> cfg-space-play-last <=> PlayerState.cfg-space-play-last;
    in-out property <int> cfg-recent-limit <=> PlayerState.cfg-recent-limit;
    in-out property <string> cfg-language <=> PlayerState.cfg-language;
    in-out property <string> cfg-theme <=> PlayerState.cfg-theme;
    in-out property <string> theme-name <=> Theme.name;
    in-out property <bool> theme-rounding <=> Theme.rounding;
    in-out property <bool> theme-shadows <=> Theme.shadows;
    in-out property <float> cfg-scale <=> PlayerState.cfg-scale;
    in-out property <int> cfg-fps <=> PlayerState.cfg-fps;
    in-out property <bool> cfg-rounding <=> PlayerState.cfg-rounding;
    in-out property <bool> cfg-shadow <=> PlayerState.cfg-shadow;
    in-out property <string> cfg-font-path <=> PlayerState.cfg-font-path;
    in-out property <int> cfg-font-size <=> PlayerState.cfg-font-size;
    in-out property <int> cfg-glyph-range <=> PlayerState.cfg-glyph-range;
    in-out property <string> cfg-log-level <=> PlayerState.cfg-log-level;
    in-out property <int> cfg-log-limit <=> PlayerState.cfg-log-limit;

    // Intent callbacks handled by the C++ Window coordinator.
    callback toggle-pause();
    callback open-file();
    callback open-folder();
    callback open-url();
    callback open-clipboard();
    callback open-disc();
    callback open-iso();
    callback open-recent(string);
    callback clear-recent();
    callback command(string);
    callback toggle-fullscreen();
    callback seek-fraction(float, bool);  // (fraction, exact) — exact only on drag release
    callback adjust-volume(float);
    callback set-volume(float);
    callback toggle-mute();
    callback flash-volume-osd();
    callback prev-file();
    callback next-file();
    callback pick-speed(float);
    callback ab-set-a();
    callback ab-set-b();
    callback ab-clear();
    callback request-context-menu(length, length);
    callback win-minimize();
    callback win-maximize();
    callback win-close();
    callback start-window-drag();
    // Hide/show the OS cursor. Slint only syncs `mouse-cursor` to the OS on a
    // pointer event, but the auto-hide fires while the mouse is idle — so the
    // arrow would linger over the video. Driven into Win32 ShowCursor instead.
    callback set-os-cursor-hidden(bool);
    callback key(string, bool, bool, bool);
    callback submit-url(string);
    // Context-menu actions
    callback select-sub(int);
    callback select-audio(int);
    callback select-video(int);
    callback select-audio-device(string);
    callback apply-profile(string);
    callback seek-chapter(int);
    callback set-aspect(string);
    callback set-always-on-top(bool);
    // Panel data + actions
    callback panel-opened(string);
    callback set-sub-delay(float);
    callback set-audio-delay(float);
    callback toggle-audio-eq();
    callback set-audio-eq(int, int);
    callback audio-eq-preset(string);
    callback load-external-sub();
    callback playlist-play(int);
    callback playlist-remove(int);
    callback playlist-add-files();
    callback playlist-add-folder();
    callback playlist-clear();
    callback cycle-repeat();
    callback toggle-shuffle();
    callback set-brightness(int);
    callback set-contrast(int);
    callback set-saturation(int);
    callback set-vid-zoom(float);
    callback toggle-deinterlace();
    callback reset-video();
    callback update-setting(string, string);
    callback pick-font();
    callback open-config();
    callback open-project();

    pure function keyname(t: string) -> string {
        t == Key.RightArrow ? "ArrowRight"
        : t == Key.LeftArrow ? "ArrowLeft"
        : t == Key.UpArrow ? "ArrowUp"
        : t == Key.DownArrow ? "ArrowDown"
        : t == Key.PageUp ? "PageUp"
        : t == Key.PageDown ? "PageDown"
        : t == Key.Space ? "Space"
        : t == Key.Escape ? "Escape"
        : t == Key.F11 ? "F11"
        : t
    }

    // Move the playhead + seek. `frac` is computed once by the caller; `exact`
    // is false while scrubbing (fast keyframe seek) and true on release.
    function seek-to(frac: float, exact: bool) {
        if (root.duration > 0) {
            root.current-time = frac * root.duration;
            root.seek-fraction(frac, exact);
        }
    }
    function close-panels() { root.active-panel = ""; }
    function toggle-panel(p: string) {
        root.active-panel = root.active-panel == p ? "" : p;
        if (root.active-panel != "") {
            if (p == "sub") { root.sub-page = "main"; }
            root.panel-opened(p);
        }
    }

    // Auto-hide the controls + cursor after idle while playing in fullscreen.
    changed fullscreen => {
        if (!self.fullscreen) { root.controls-visible = true; root.cursor-hidden = false; }
    }
    // Mirror the cursor-hidden state to the OS so the arrow actually vanishes
    // while the mouse is idle (the reactive `mouse-cursor` binding alone only
    // takes effect on the next pointer event).
    changed cursor-hidden => { root.set-os-cursor-hidden(self.cursor-hidden); }
    // Only ticks while it can actually do something (fullscreen playback), so a
    // windowed or paused player isn't woken every frame. 100ms × 5 = ~500ms of
    // idle before the cursor hides, matching the Tauri build's snappy feel.
    hide-timer := Timer {
        interval: 100ms;
        running: root.has-file && root.fullscreen && root.playing;
        triggered => {
            root.idle-ticks += 1;
            // Hovering a control bar keeps it up (and resets the grace period, so
            // moving off the bar onto the video gives a fresh countdown).
            if (root.top-hovered || root.bottom-hovered) {
                root.idle-ticks = 0;
            } else if (root.idle-ticks >= 5 && root.active-panel == "" && !root.ctx-show && !root.url-show) {
                root.controls-visible = false;
                root.cursor-hidden = true;
            }
        }
    }

    // Auto-dismiss the transient toast after a few seconds (also cleared on tap).
    toast-timer := Timer {
        interval: 4s;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }

    // Volume OSD: briefly show the current level on the video when the USER
    // changes it, so the tweak is visible even with the controls hidden in
    // fullscreen. Fired from the bridge's volume paths — not `changed volume`
    // — so mpv's own volume echoes on load don't pop the OSD. Mirrors the
    // idle-ticks pattern: each change resets the countdown, so holding a key
    // keeps it on screen.
    property <int> vol-osd-ticks: 100;
    property <bool> vol-osd-show: root.has-file && root.vol-osd-ticks < 8;
    flash-volume-osd => { root.vol-osd-ticks = 0; }
    vol-osd-timer := Timer {
        interval: 150ms;
        running: root.vol-osd-ticks < 8;
        triggered => { root.vol-osd-ticks += 1; }
    }

    forward-focus: keyfocus;
    keyfocus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape && root.ctx-show) {
                root.ctx-show = false;
            } else if (e.text == Key.Escape && root.active-panel != "") {
                root.close-panels();
            } else {
                root.key(root.keyname(e.text), e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
            }
            accept
        }
    }

    // Video surface rendered by ImPlay beneath the Slint chrome.
    Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: root.video-frame;
        image-fit: contain;
        visible: root.has-file;
    }

    // Video surface + whole-window input.
    Rectangle {
        background: root.has-file ? transparent : #000000;
        area := TouchArea {
            mouse-cursor: root.cursor-hidden ? MouseCursor.none : MouseCursor.default;
            double-clicked => { root.toggle-fullscreen(); }
            clicked => {
                if (root.has-file && root.active-panel == "" && !root.ctx-show) {
                    root.toggle-pause();
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.move) {
                    root.idle-ticks = 0;
                    root.cursor-hidden = false;
                    if (!root.fullscreen) { root.controls-visible = true; }
                    else { root.controls-visible = self.mouse-y <= 50px || self.mouse-y >= root.height - 80px; }
                } else if (e.kind == PointerEventKind.down) {
                    if (e.button == PointerEventButton.right) {
                        root.request-context-menu(self.mouse-x, self.mouse-y);
                    } else if (e.button == PointerEventButton.left) {
                        root.close-panels();
                    }
                }
            }
            scroll-event(e) => { root.adjust-volume(e.delta-y > 0 ? 5 : -5); accept }
        }

        if !root.has-file: VerticalLayout {
            alignment: center;
            spacing: 6px;
            HorizontalLayout { alignment: center; AppIcon { data: Ic.play-circle; size: 72px; color: #ffffff44; } }
            HorizontalLayout { alignment: center; Text { text: "ImPlay"; color: #ffffff66; font-size: 14px; } }
            HorizontalLayout {
                alignment: center; spacing: 6px;
                Text { text: @tr("Drop a file here or press"); color: #ffffff40; font-size: 12px; vertical-alignment: center; }
                Rectangle {
                    background: #ffffff1a; border-radius: 4px;
                    chip := HorizontalLayout { padding-left: 6px; padding-right: 6px; padding-top: 2px; padding-bottom: 2px; Text { text: "Ctrl+O"; color: #ffffff73; font-size: 11px; } }
                    width: chip.preferred-width; height: chip.preferred-height;
                }
                Text { text: @tr("to open"); color: #ffffff40; font-size: 12px; vertical-alignment: center; }
            }
        }
    }

    // --- Title bar ---
    if root.controls-visible && !root.fullscreen: Rectangle {
        y: 0;
        height: 36px;
        background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
        // Hover-only surface behind the controls keeps the bar visible without
        // stealing pointer presses from the window buttons.
        TouchArea {
            changed has-hover => { root.top-hovered = self.has-hover; }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 2px;
            VerticalLayout {
                alignment: center;
                CtrlButton {
                    width: 28px; height: 28px; icon: Ic.menu; icon-size: 16px; square-hover: true;
                    clicked => { root.request-context-menu(8px, 40px); }
                }
            }
            // Only this center surface starts a native move. The window controls
            // are siblings, so clicking them cannot accidentally begin a drag.
            title-drag := TouchArea {
                horizontal-stretch: 1;
                double-clicked => { root.win-maximize(); }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.start-window-drag();
                    }
                }
                Text {
                    text: root.media-title == "" ? "ImPlay" : root.media-title;
                    color: #ffffffcc; font-size: 12px; vertical-alignment: center;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    CtrlButton { width: 32px; height: 28px; icon: Ic.win-min; icon-size: 16px; square-hover: true; clicked => { root.win-minimize(); } }
                    CtrlButton { width: 32px; height: 28px; icon: Ic.win-max; icon-size: 14px; square-hover: true; clicked => { root.win-maximize(); } }
                    CtrlButton { width: 32px; height: 28px; icon: Ic.close-x; icon-size: 16px; square-hover: true; danger: true; clicked => { root.win-close(); } }
                }
            }
        }
    }

    // --- Bottom controls ---
    if root.controls-visible: Rectangle {
        y: parent.height - self.height;
        height: bottombox.preferred-height;
        background: @linear-gradient(180deg, #00000000 0%, #000000cc 100%);
        // Hover-only surface behind the controls. Keeping it out of the control
        // hierarchy prevents it from stealing seek/button/volume input.
        TouchArea {
            changed has-hover => { root.bottom-hovered = self.has-hover; }
        }
        bottombox := VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 6px;
            spacing: 4px;

            // A-B loop bar
            if root.ab-enabled: HorizontalLayout {
                spacing: 6px;
                height: 32px;
                ab-pill := Rectangle {
                    width: 64px;
                    border-radius: Theme.radius-sm;
                    background: root.ab-a >= 0 ? Theme.accent : #ffffff26;
                    TouchArea { clicked => { root.ab-set-a(); } }
                    Text {
                        text: root.ab-a >= 0 ? "A \{Catalog.fmt-time(root.ab-a)}" : "A";
                        color: root.ab-a >= 0 ? black : white;
                        font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                Rectangle {
                    width: 64px;
                    border-radius: Theme.radius-sm;
                    background: root.ab-b >= 0 ? Theme.accent : #ffffff26;
                    opacity: root.ab-a >= 0 ? 1.0 : 0.3;
                    TouchArea { clicked => { if (root.ab-a >= 0) { root.ab-set-b(); } } }
                    Text {
                        text: root.ab-b >= 0 ? "B \{Catalog.fmt-time(root.ab-b)}" : "B";
                        color: root.ab-b >= 0 ? black : white;
                        font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                }
                CtrlButton { icon: Ic.close-x; icon-size: 16px; width: 32px; height: 32px; clicked => { root.ab-clear(); } }
                Rectangle {}
            }

            // Seek bar
            Rectangle {
                height: 16px;
                seek := TouchArea {
                    // Scrub with fast keyframe seeks while dragging, then one exact
                    // seek on release so the playhead lands precisely. The thumb
                    // tracks the cursor instantly (optimistic current-time in seek-to).
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.move && self.pressed) {
                            root.seek-to(clamp(self.mouse-x / self.width, 0, 1), false);
                        } else if (e.kind == PointerEventKind.up) {
                            root.seek-to(clamp(self.mouse-x / self.width, 0, 1), true);
                        }
                    }
                }
                track := Rectangle {
                    y: parent.height / 2 - 2px;
                    height: seek.has-hover ? 5px : 4px;
                    background: Theme.surface-container-highest;
                    border-radius: 2px;
                    animate height { duration: 100ms; }
                    // Hover preview: a lighter fill up to the cursor (YouTube-style),
                    // under the played fill so the played part stays accent-coloured.
                    Rectangle {
                        x: 0;
                        width: clamp(seek.mouse-x, 0px, parent.width);
                        height: parent.height;
                        background: #ffffff33;
                        border-radius: 2px;
                        visible: seek.has-hover;
                    }
                    // played progress
                    Rectangle {
                        x: 0;
                        width: parent.width * (root.duration > 0 ? root.current-time / root.duration : 0);
                        height: parent.height;
                        background: Theme.accent;
                        border-radius: 2px;
                    }
                    // A-B region
                    if root.ab-a >= 0 && root.duration > 0: Rectangle {
                        x: parent.width * (root.ab-a / root.duration);
                        width: parent.width * ((root.ab-b >= 0 ? root.ab-b / root.duration : 1) - root.ab-a / root.duration);
                        height: parent.height;
                        background: #ffffff40;
                    }
                    // chapter ticks
                    for ch in root.chapters: Rectangle {
                        x: parent.width * (root.duration > 0 ? ch.time / root.duration : 0);
                        width: 2px;
                        height: parent.height;
                        background: #ffffff66;
                    }
                }
                // thumb
                Rectangle {
                    width: 12px; height: 12px; border-radius: 6px; background: white;
                    x: (parent.width - self.width) * (root.duration > 0 ? root.current-time / root.duration : 0);
                    y: parent.height / 2 - self.height / 2;
                }
            }

            // Control row
            HorizontalLayout {
                spacing: 2px;
                CtrlButton { icon: root.playing ? Ic.pause : Ic.play; clicked => { root.toggle-pause(); } }
                CtrlButton { icon: Ic.prev; clicked => { root.prev-file(); } }
                CtrlButton { icon: Ic.next; clicked => { root.next-file(); } }

                // Volume: mute + slider as one unit (YouTube-style)
                VerticalLayout {
                    alignment: center;
                    VolumeControl {
                        volume: root.volume;
                        maximum: root.max-volume;
                        muted: root.muted;
                        icon-on: Ic.volume-on;
                        icon-off: Ic.volume-off;
                        toggle-mute => { root.toggle-mute(); }
                        set-volume(v) => { root.set-volume(v); }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    TouchArea {
                        width: timetext.preferred-width + 8px;
                        clicked => { root.show-remaining = !root.show-remaining; }
                        timetext := Text {
                            text: (root.show-remaining && root.duration > 0)
                                ? "-\{Catalog.fmt-time(root.duration - root.current-time)} / \{Catalog.fmt-time(root.duration)}"
                                : "\{Catalog.fmt-time(root.current-time)} / \{Catalog.fmt-time(root.duration)}";
                            color: #ffffffb3; font-size: 12px; vertical-alignment: center;
                        }
                    }
                }

                Rectangle {}  // spacer

                CtrlButton { icon: Ic.subtitles; active: root.active-panel == "sub"; clicked => { root.toggle-panel("sub"); } }
                CtrlButton { icon: Ic.audio; active: root.active-panel == "audio"; clicked => { root.toggle-panel("audio"); } }
                CtrlButton { icon: Ic.movie; active: root.active-panel == "video"; clicked => { root.toggle-panel("video"); } }
                // Speed
                VerticalLayout {
                    alignment: center;
                    spdbtn := TouchArea {
                        width: 40px; height: 36px;
                        clicked => { root.toggle-panel("speed"); }
                        Rectangle {
                            background: spdbtn.has-hover ? #ffffff2e : transparent;
                            border-radius: self.height / 2;
                            Text {
                                text: "\{root.speed}x";
                                color: root.active-panel == "speed" ? Theme.accent : #ffffffe6;
                                font-size: 13px; font-weight: 500;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
                CtrlButton { icon: Ic.playlist; active: root.active-panel == "playlist"; clicked => { root.toggle-panel("playlist"); } }
                CtrlButton { icon: Ic.settings; active: root.active-panel == "settings"; clicked => { root.toggle-panel("settings"); } }
                CtrlButton { icon: Ic.fullscreen; clicked => { root.toggle-fullscreen(); } }
            }
        }
    }

    // --- Transient toast (top-center, above the controls; tap to dismiss) ---
    if root.toast != "": HorizontalLayout {
        x: 0; y: 48px; width: 100%; height: 34px;
        alignment: center;
        Rectangle {
            background: #1e1e1ef2;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: #ffffff1f;
            TouchArea { clicked => { root.toast = ""; } }
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                Text { text: root.toast; color: #ffffffe6; font-size: 12px; vertical-alignment: center; }
            }
        }
    }

    // --- Volume OSD (transient): a minimal icon + percentage pill, top-center.
    // No progress bar — just the level. The percentage has a fixed width so the
    // pill never jitters as digits change while holding the key.
    if root.vol-osd-show: Rectangle {
        x: (root.width - self.width) / 2;
        y: 44px;
        height: 38px;
        width: vol-osd-row.preferred-width;
        background: #000000b3;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: #ffffff1f;
        vol-osd-row := HorizontalLayout {
            padding-left: 15px;
            padding-right: 17px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                AppIcon {
                    data: (root.muted || root.volume == 0) ? Ic.volume-off : Ic.volume-on;
                    size: 19px;
                    color: #ffffffe6;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.muted ? "0%" : "\{round(root.volume)}%";
                    color: #ffffffe6;
                    font-size: 15px;
                    font-weight: 600;
                    width: 42px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // --- Speed dropdown ---
    if root.active-panel == "speed": MenuSurface {
        x: parent.width - self.width - 92px;
        y: parent.height - self.height - 56px;
        width: 120px;
        height: speedlist.preferred-height + 12px;
        speedlist := VerticalLayout {
            padding-top: 6px; padding-bottom: 6px;
            for s in Catalog.speeds: MenuItem {
                show-check: true; checked: root.speed == s; active: root.speed == s;
                label: "\{s}x";
                clicked => { root.pick-speed(s); root.close-panels(); }
            }
        }
    }

    // --- Audio panel ---
    if root.active-panel == "audio": SidePanel {
        heading: @tr("Audio");
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 64px;
        VScroll {
            // Cap relative to the window so the panel never overflows a short,
            // non-maximized player (mirrors how the Settings modal sizes itself).
            max-height: min(280px, root.height - 200px);
            aulist := VerticalLayout {
                for t in root.panel-audio-tracks: MenuItem { show-check: true; checked: t.selected; active: t.selected; label: t.label; clicked => { root.select-audio(t.id); } }
            }
        }
        if root.panel-audio-tracks.length == 0: Text { text: @tr("No audio tracks"); color: #ffffff4d; font-size: 12px; height: 48px; horizontal-alignment: center; vertical-alignment: center; }
        MenuSep {}
        Stepper {
            label: @tr("Delay"); value: "\{round(root.audio-delay * 10) / 10}s";
            active: root.audio-delay != 0;
            dec => { root.audio-delay = round((root.audio-delay - 0.1) * 10) / 10; root.set-audio-delay(root.audio-delay); }
            inc => { root.audio-delay = round((root.audio-delay + 0.1) * 10) / 10; root.set-audio-delay(root.audio-delay); }
            reset => { root.audio-delay = 0; root.set-audio-delay(0); }
        }
        MenuSep {}
        MenuItem { icon: Ic.graphic-eq; label: "10-band equalizer"; arrow: true; active: root.audio-eq-enabled; clicked => { root.active-panel = "audio-eq"; } }
    }

    // --- Original ImPlay ten-band audio equalizer ---
    if root.active-panel == "audio-eq": SidePanel {
        heading: "Audio Equalizer";
        panel-width: 320px;
        show-back: true;
        back => { root.active-panel = "audio"; }
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: max(12px, parent.height - self.height - 64px);
        MenuItem {
            icon: Ic.graphic-eq; label: "Enabled"; show-check: true;
            checked: root.audio-eq-enabled; active: root.audio-eq-enabled;
            clicked => { root.toggle-audio-eq(); }
        }
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 4px;
            MenuItem { horizontal-stretch: 1; label: "Flat"; clicked => { root.audio-eq-preset("flat"); } }
            MenuItem { horizontal-stretch: 1; label: "Bass"; clicked => { root.audio-eq-preset("bass"); } }
            MenuItem { horizontal-stretch: 1; label: "Rock"; clicked => { root.audio-eq-preset("rock"); } }
        }
        MenuSep {}
        VScroll {
            min-height: 120px;
            max-height: min(360px, root.height - 180px);
            VerticalLayout {
                for band[i] in root.audio-eq-bands: Stepper {
                    label: root.audio-eq-labels[i] + " Hz";
                    value: "\{band} dB";
                    active: band != 0;
                    dec => { root.set-audio-eq(i, max(-12, band - 1)); }
                    inc => { root.set-audio-eq(i, min(12, band + 1)); }
                    reset => { root.set-audio-eq(i, 0); }
                }
            }
        }
    }

    // --- Original ImPlay video quick view ---
    if root.active-panel == "video": SidePanel {
        heading: "Video";
        panel-width: 330px;
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: max(12px, parent.height - self.height - 64px);
        VScroll {
            min-height: 160px;
            max-height: min(430px, root.height - 150px);
            VerticalLayout {
                for t in root.ctx-video-tracks: MenuItem { show-check: true; checked: t.selected; active: t.selected; label: t.label; clicked => { root.select-video(t.id); } }
                MenuSep {}
                MenuItem { icon: Ic.refresh; label: "Rotate 90 degrees"; clicked => { root.command("add video-rotate 90"); } }
                MenuItem { icon: Ic.aspect; label: "Aspect: Auto"; clicked => { root.set-aspect("-1"); } }
                MenuItem { icon: Ic.aspect; label: "Aspect: 16:9"; clicked => { root.set-aspect("16:9"); } }
                Stepper {
                    label: "Brightness"; value: "\{root.brightness}"; active: root.brightness != 0;
                    dec => { root.set-brightness(max(-100, root.brightness - 1)); }
                    inc => { root.set-brightness(min(100, root.brightness + 1)); }
                    reset => { root.set-brightness(0); }
                }
                Stepper {
                    label: "Contrast"; value: "\{root.contrast}"; active: root.contrast != 0;
                    dec => { root.set-contrast(max(-100, root.contrast - 1)); }
                    inc => { root.set-contrast(min(100, root.contrast + 1)); }
                    reset => { root.set-contrast(0); }
                }
                Stepper {
                    label: "Saturation"; value: "\{root.saturation}"; active: root.saturation != 0;
                    dec => { root.set-saturation(max(-100, root.saturation - 1)); }
                    inc => { root.set-saturation(min(100, root.saturation + 1)); }
                    reset => { root.set-saturation(0); }
                }
                Stepper {
                    label: "Zoom"; value: "\{round(root.vid-zoom * 10) / 10}"; active: root.vid-zoom != 0;
                    dec => { root.set-vid-zoom(max(-2, root.vid-zoom - 0.1)); }
                    inc => { root.set-vid-zoom(min(2, root.vid-zoom + 0.1)); }
                    reset => { root.set-vid-zoom(0); }
                }
                MenuItem { icon: Ic.movie; label: "Hardware decoding: toggle"; clicked => { root.command("cycle-values hwdec auto no"); } }
                MenuItem { icon: Ic.movie; label: "Deinterlace"; show-check: true; checked: root.deinterlace; active: root.deinterlace; clicked => { root.toggle-deinterlace(); } }
                MenuItem { icon: Ic.refresh; label: "Reset video adjustments"; clicked => { root.reset-video(); } }
            }
        }
    }

    // --- mpv command console (the original debug command path) ---
    if root.active-panel == "command": SidePanel {
        heading: "mpv Command";
        panel-width: 420px;
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 64px;
        VerticalLayout {
            padding: 14px; spacing: 10px;
            Text { text: "Run any mpv command"; color: #ffffff80; font-size: 12px; }
            Rectangle {
                height: 34px; background: #ffffff14; border-radius: Theme.radius-sm;
                border-width: 1px; border-color: cmd.has-focus ? Theme.accent : Theme.outline;
                HorizontalLayout {
                    padding-left: 10px; padding-right: 10px;
                    cmd := TextInput {
                        text <=> root.command-text;
                        color: white; font-size: 12px; single-line: true; vertical-alignment: center;
                        accepted => { if root.command-text != "" { root.command(root.command-text); root.command-text = ""; } }
                    }
                }
            }
            MenuItem { icon: Ic.play; label: "Run command"; key-hint: "Enter"; clicked => { if root.command-text != "" { root.command(root.command-text); root.command-text = ""; } } }
            Text { text: "Examples: show-progress, cycle deinterlace, set speed 1.25"; color: #ffffff59; font-size: 11px; wrap: word-wrap; }
        }
    }

    // --- Playlist panel ---
    if root.active-panel == "playlist": SidePanel {
        heading: @tr("Playlist");
        panel-width: 340px;
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 64px;
        VScroll {
            // Hug the list up to a window-relative cap. Uses max-height (not a
            // plain height) so the cap actually bounds the panel — a plain height
            // lets VScroll's content-preferred height leak through and oversize it.
            min-height: 40px;
            max-height: min(420px, root.height - 200px);
            pllist := VerticalLayout {
                for item[i] in root.playlist-items: Rectangle {
                    height: 32px;
                    pa := TouchArea { double-clicked => { root.playlist-play(item.index); } }
                    RowHover { fill: pa.has-hover ? Theme.hover : (item.current ? #ffffff0d : transparent); }
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 6px; spacing: 8px;
                        Rectangle {
                            width: 18px;
                            if item.current: AppIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                data: Ic.play; size: 11px; color: Theme.accent;
                            }
                            if !item.current: Text {
                                width: 100%; height: 100%;
                                text: "\{i + 1}"; color: #ffffff40; font-size: 11px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text { text: item.title; color: item.current ? Theme.accent : #ffffffcc; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        // Remove-from-playlist X (always visible, brightens on row
                        // hover, turns red when hovered directly).
                        VerticalLayout {
                            alignment: center;
                            rmta := TouchArea {
                                width: 26px; height: 26px;
                                clicked => { root.playlist-remove(item.index); }
                                Rectangle {
                                    background: rmta.has-hover ? #ef444433 : transparent;
                                    border-radius: self.height / 2;
                                    AppIcon {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        data: Ic.close-x;
                                        size: 13px;
                                        color: rmta.has-hover ? #ef4444 : (pa.has-hover ? #ffffffcc : #ffffff45);
                                    }
                                }
                            }
                        }
                    }
                }
                if root.playlist-items.length == 0: Text { text: @tr("Empty playlist"); color: #ffffff4d; font-size: 12px; height: 64px; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        MenuSep {}
        HorizontalLayout {
            padding: 6px; spacing: 2px;
            CtrlButton { width: 30px; height: 30px; icon-size: 16px; icon: Ic.shuffle; active: root.shuffle; clicked => { root.toggle-shuffle(); } }
            CtrlButton { width: 30px; height: 30px; icon-size: 16px; icon: Ic.repeat; active: root.repeat-mode != "off"; clicked => { root.cycle-repeat(); } }
            Rectangle {}
            CtrlButton { width: 30px; height: 30px; icon-size: 16px; icon: Ic.plus; clicked => { root.playlist-add-files(); } }
            CtrlButton { width: 30px; height: 30px; icon-size: 16px; icon: Ic.add-folder; clicked => { root.playlist-add-folder(); } }
            CtrlButton { width: 30px; height: 30px; icon-size: 16px; icon: Ic.trash; clicked => { root.playlist-clear(); } }
        }
    }

    // --- Media info panel ---
    if root.active-panel == "info": SidePanel {
        heading: @tr("Media Info");
        close => { root.close-panels(); }
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 64px;
        VerticalLayout {
            padding: Theme.pad; spacing: 6px;
            for row in root.info-rows: HorizontalLayout {
                spacing: 12px;
                height: 18px;
                Text { text: row.label; color: #ffffff80; font-size: 12px; vertical-alignment: center; }
                Rectangle {}
                Text { text: row.value; color: #ffffffe6; font-size: 12px; vertical-alignment: center; overflow: elide; max-width: 170px; }
            }
        }
    }

    // --- Subtitle quick view ---
    if root.active-panel == "sub": SubtitlePanel {
        x: parent.width - self.width - 16px;
        y: parent.height - self.height - 64px;
        close => { root.close-panels(); }
        select-sub(id) => { root.select-sub(id); }
        load-external-sub => { root.load-external-sub(); }
        command(c) => { root.command(c); }
        set-sub-delay(v) => { root.set-sub-delay(v); }
    }

    // --- Settings (centered modal) ---
    if root.active-panel == "settings": SettingsPanel {
        update-setting(k, v) => { root.update-setting(k, v); }
        pick-font => { root.pick-font(); }
        open-config => { root.open-config(); }
        open-project => { root.open-project(); }
    }


    // --- Open URL modal ---
    if root.url-show: Rectangle {
        background: #00000066;
        TouchArea { clicked => { root.url-show = false; } }
        MenuSurface {
            width: 460px;
            height: 130px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            TouchArea {}
            VerticalLayout {
                padding: 16px; spacing: 12px;
                Text { text: @tr("Open URL"); color: #ffffffe6; font-size: 14px; font-weight: 600; }
                Rectangle {
                    height: 32px; background: #ffffff14; border-radius: Theme.radius-sm;
                    border-width: 1px; border-color: ut.has-focus ? Theme.accent : Theme.outline;
                    HorizontalLayout {
                        padding-left: Theme.pad; padding-right: Theme.pad;
                        ut := TextInput {
                            text <=> root.url-text;
                            color: white; font-size: 12px; vertical-alignment: center; single-line: true; horizontal-stretch: 1;
                            accepted => { root.submit-url(root.url-text); root.url-text = ""; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px; alignment: end;
                    TouchArea { width: 80px; height: 30px; clicked => { root.url-show = false; }
                        Rectangle { background: #ffffff10; border-radius: Theme.radius-sm; Text { text: @tr("Cancel"); color: #ffffffb3; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } } }
                    TouchArea { width: 80px; height: 30px; clicked => { root.submit-url(root.url-text); root.url-text = ""; }
                        Rectangle { background: Theme.accent; border-radius: Theme.radius-sm; Text { text: @tr("OK"); color: black; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; } } }
                }
            }
        }
    }

    // --- Context menu (right-click / hamburger) ---
    if root.ctx-show: ContextMenu {
        command(c) => { root.command(c); }
        open-file => { root.open-file(); }
        open-folder => { root.open-folder(); }
        open-url => { root.open-url(); }
        open-clipboard => { root.open-clipboard(); }
        open-disc => { root.open-disc(); }
        open-iso => { root.open-iso(); }
        open-recent(p) => { root.open-recent(p); }
        clear-recent => { root.clear-recent(); }
        set-always-on-top(v) => { root.set-always-on-top(v); }
        select-sub(id) => { root.select-sub(id); }
        select-audio(id) => { root.select-audio(id); }
        select-video(id) => { root.select-video(id); }
        select-audio-device(v) => { root.select-audio-device(v); }
        apply-profile(v) => { root.apply-profile(v); }
        playlist-add-files => { root.playlist-add-files(); }
        playlist-add-folder => { root.playlist-add-folder(); }
        seek-chapter(i) => { root.seek-chapter(i); }
        set-aspect(v) => { root.set-aspect(v); }
    }

}
