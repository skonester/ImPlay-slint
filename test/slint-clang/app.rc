#include <winver.h>

#define VERSION 1,5,1,0
#define VERSION_STR "1.5.1.0\0"

GLFW_ICON ICON "C:/Users/admin/Documents/GitHub/ImPlay-clang/resources/win32/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION
PRODUCTVERSION VERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ImPlay\0"
            VALUE "FileVersion", VERSION_STR
            VALUE "InternalName", "ImPlay\0"
            VALUE "ProductName", "ImPlay\0"
            VALUE "OriginalFilename", "ImPlay.exe\0"
            VALUE "ProductVersion", VERSION_STR
            VALUE "LegalCopyright", "Copyright (c) 2022-2025 tsl0922\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 RT_MANIFEST "C:/Users/admin/Documents/GitHub/ImPlay-clang/resources/win32/app.manifest"
